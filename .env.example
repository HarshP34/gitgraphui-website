# Get a free access key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# App version → installer: git-graph-ui-setup-{version}.exe
VITE_APP_VERSION=1.0.0

# GitHub releases repo (installer download is built from this URL)
VITE_RELEASES_URL=https://github.com/HarshP34/git-graph-ui-releases


# git-graph-ui-releases
# Windows installer downloads for Git Graph UI — visual Git client with commit graph, diff viewer, merge conflicts, and local-only privacy. Release artifacts only.